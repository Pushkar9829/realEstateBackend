      "<rootDir>/tests/env.js"
    ],
    "testTimeout": 30000
  },
  "dependencies": {
    "axios": "^1.20.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.5",
    "multer": "^2.4.0",
    "nodemailer": "^6.10.1",
    "otplib": "^12.0.1",
    "pdfkit": "^0.15.2",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.33.5",
    "uuid": "^11.1.1",
    "zod": "^3.25.76"
