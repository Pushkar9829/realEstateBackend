{
  "name": "realestate-platform-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Real estate property platform API (Express + MongoDB). Deploy: Render.",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "seed": "node scripts/seed.js",
    "seed:demo": "node scripts/seed-demo-data.js",
    "demo:coverage": "node scripts/demo-coverage.js",
    "routes": "node scripts/print-routes.js",
    "test": "jest --runInBand"
  },
  "jest": {
    "testEnvironment": "node",
